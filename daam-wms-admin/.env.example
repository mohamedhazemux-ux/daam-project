# ─────────────────────────────────────────────────────────────────────────────
# DAAM WMS Admin — متغيرات البيئة
# انسخ هذا الملف إلى .env.local واضبط القيم حسب بيئتك
# ─────────────────────────────────────────────────────────────────────────────

# URL الخادم الخلفي — اتركه /api عند استخدام Vite proxy في التطوير المحلي
VITE_API_BASE_URL=/api

# وضع البيانات التجريبية:
#   true  → يستخدم البيانات التجريبية المحلية (الافتراضي في dev)
#   false → يتصل بالـ backend الحقيقي عبر VITE_API_BASE_URL
VITE_USE_MOCK=true

# ── للتطوير المحلي مع Backend حقيقي ─────────────────────────────────────────
# فعّل Vite Proxy لتوجيه /api إلى الخادم المحلي
# VITE_API_PROXY_TARGET=http://localhost:3000
